    public static void updateCreditNoteAmountOnInvoice(List<Sales_Return_Item__c> newList,Map<Id, Sales_Return_Item__c> oldMap, Boolean isInsert, Boolean isUpdate, Boolean isDelete,
        Boolean isUndelete)
    {
        if (SaleReturnIQCDecesionHandler.isRunning) {
        	return;
    	}

    	SaleReturnIQCDecesionHandler.isRunning = true;
        try{
		system.debug('IN updateCreditNoteAmountOnInvoice');
        Map<Id, Decimal> invoiceDeltaMap = new Map<Id, Decimal>();
        Map<Id, Decimal> sriDeltaMap = new Map<Id, Decimal>();
        set<Sales_Return_Item__c> stiSet = new set<Sales_Return_Item__c>();
		// DELETE case → use oldMap
        if (isDelete) {
            for (Sales_Return_Item__c oldRec : oldMap.values()) {
                if (oldRec.Invoice__c != null && oldRec.Status__c == 'IQC Verified') {
                    Decimal amt = oldRec.Total_Amount__c == null ? 0 : oldRec.Total_Amount__c;
                    invoiceDeltaMap.put(
                        oldRec.Invoice__c,
                        (invoiceDeltaMap.containsKey(oldRec.Invoice__c)
                            ? invoiceDeltaMap.get(oldRec.Invoice__c)
                            : 0) - amt   // subtract
                    );
                    sriDeltaMap.put(oldRec.Id, -amt);
                }
            }
        }

        // INSERT / UPDATE / UNDELETE
        if (!isDelete) {
			
            for (Sales_Return_Item__c newRec : newList) {
                if(newRec.Pending_Credit_Note_Amount__c > 0){
                Sales_Return_Item__c oldRec =
                    (isUpdate && oldMap != null) ? oldMap.get(newRec.Id) : null;
                
				if (isUpdate && oldRec != null && oldRec.Status__c == 'IQC Verified' && newRec.Status__c == 'WO Raised') {
            		continue;
        		}
                
                Decimal oldAmt = 0;
                Decimal newAmt = 0;

                if (oldRec != null && oldRec.Status__c == 'IQC Verified') {
                    oldAmt = oldRec.Credit_Note_Amount__c == null ? 0 : oldRec.Credit_Note_Amount__c;
                }

                if (newRec.Status__c == 'IQC Verified') {
                    newAmt = newRec.Pending_Credit_Note_Amount__c == null ? 0 : newRec.Pending_Credit_Note_Amount__c; 
                }

                Decimal delta = newAmt + oldAmt;
				if (delta != 0 && newRec.Invoice_Line_Item__c != null) {
                    invoiceDeltaMap.put(
                        newRec.Invoice_Line_Item__c,
                        (invoiceDeltaMap.containsKey(newRec.Invoice_Line_Item__c)
                            ? invoiceDeltaMap.get(newRec.Invoice_Line_Item__c)
                            : 0) + newAmt
                    );
                    sriDeltaMap.put(newRec.Id, oldAmt);
                    stiSet.add(newRec);
                }
                /*if (delta != 0 && newRec.Invoice__c != null) {
                    invoiceDeltaMap.put(
                        newRec.Invoice__c,
                        (invoiceDeltaMap.containsKey(newRec.Invoice__c)
                            ? invoiceDeltaMap.get(newRec.Invoice__c)
                            : 0) + newAmt
                    );
                    sriDeltaMap.put(newRec.Id, oldAmt);
                }*/
                }    
            }
        }
		system.debug('invoiceDeltaMap size--'+invoiceDeltaMap.size());
        
		system.debug('stiSet size--'+stiSet.size());
        if (invoiceDeltaMap.isEmpty()) return;

        //List<Invoice__c> invoicesToUpdate = [SELECT Id, Credit_Note_Amount__c,Due_Amount__c FROM Invoice__c WHERE Id IN :invoiceDeltaMap.keySet()];
		List<Invoice_Line_Item__c> invoicesToUpdate = [SELECT Id,Invoice__r.Due_Amount__c, Credit_Note_Amount__c FROM Invoice_Line_Item__c WHERE Id IN :invoiceDeltaMap.keySet()];
        map<Id,Decimal> mapinvItemCNAmount = new map<Id,Decimal>();
        for(Invoice_Line_Item__c iin : invoicesToUpdate){
            mapinvItemCNAmount.put(iin.Id,(iin.Credit_Note_Amount__c != null ? iin.Credit_Note_Amount__c : 0));
        }
		List<Invoice_Line_Item__c> updateList = new List<Invoice_Line_Item__c>();
		List<Sales_Return_Item__c> sriUpdates = new List<Sales_Return_Item__c>();
        for (Sales_Return_Item__c inv : stiSet) {
            system.debug('inv.Invoice_Line_Item__c--'+inv.Invoice_Line_Item__c);
            system.debug('inv.Pending_Credit_Note_Amount__c--'+inv.Pending_Credit_Note_Amount__c);
            if(inv.Invoice_Line_Item__c != null && inv.Pending_Credit_Note_Amount__c > 0){
                Invoice_Line_Item__c invItem = new Invoice_Line_Item__c();
                invItem.Id = inv.Invoice_Line_Item__c;
                invItem.Credit_Note_Amount__c = inv.Pending_Credit_Note_Amount__c + mapinvItemCNAmount.get(inv.Invoice_Line_Item__c);
                updateList.add(invItem);
                
                Sales_Return_Item__c sri = new Sales_Return_Item__c();
                sri.Id = inv.Id;
                sri.Credit_Note_Amount__c = (inv.Credit_Note_Amount__c != null ? inv.Credit_Note_Amount__c : 0) + inv.Pending_Credit_Note_Amount__c;
				sriUpdates.add(sri);
            }
        }
        system.debug('updateList size--'+updateList.size());
        
		system.debug('sriUpdates size--'+sriUpdates.size());

        if (!updateList.isEmpty()) {
            update updateList;
        }
        if (!sriUpdates.isEmpty()){
	        update sriUpdates;
        }
         }catch(Exception e){
            System.debug('updateCreditNoteAmountOnInvoice Error message--' + e.getMessage());
            System.debug('Error line no--' + e.getLineNumber());
        }
	}

