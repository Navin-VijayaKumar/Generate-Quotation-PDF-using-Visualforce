trigger assCandidateTrigger on Child__c (
    after delete,
    after insert,
    after undelete,
    after update,
    before delete,
    before insert,
    before update
) {
    if (Trigger.isBefore) {

        if (Trigger.isInsert) {
        }

        if (Trigger.isUpdate) {
        }

        if (Trigger.isDelete) {
        }

    } else {

        // =========================================
        // AFTER INSERT
        // =========================================
        if (Trigger.isInsert) {
            assCandidateTriggerHandlers.sendnotification(
                Trigger.new
            );
        }

        // =========================================
        // AFTER UPDATE
        // =========================================
        if (Trigger.isUpdate) {

            List<Child__c> hrInterviewList      = new List<Child__c>();
            List<Child__c> shreyaInterviewList  = new List<Child__c>();

            for (Child__c newRec : Trigger.new) {
                Child__c oldRec = Trigger.oldMap.get(newRec.Id);

                // ── Task 1: HR Interview Scheduled ──────────────────
                if (
                    newRec.Status__c == 'HR Interview Scheduled' &&
                    newRec.Interview_Date_Time__c != null &&
                    newRec.Interview_Date_Time__c != oldRec.Interview_Date_Time__c
                ) {
                    hrInterviewList.add(newRec);
                }

                // ── Task 2: Shreya's Interview Round ────────────────
                if (
                    newRec.Status__c == 'Shreya\'s Interview Round' &&
                    newRec.Interview_Date_Time__c != null &&
                    (
                        newRec.Status__c != oldRec.Status__c ||
                        newRec.Interview_Date_Time__c != oldRec.Interview_Date_Time__c
                    )
                ) {
                    shreyaInterviewList.add(newRec);
                }
            }

            if (!hrInterviewList.isEmpty()) {
                assCandidateTriggerHandlers.sendInterviewScheduledNotification(
                    hrInterviewList
                );
            }

            if (!shreyaInterviewList.isEmpty()) {
                assCandidateTriggerHandlers.sendShreyaInterviewNotification(
                    shreyaInterviewList
                );
            }
        }

        // =========================================
        // AFTER DELETE
        // =========================================
        if (Trigger.isDelete) {
            assCandidateSendEmailHandler.sendEmailOnDelete(
                Trigger.old
            );
        }

        if (Trigger.isUndelete) {
        }
    }
}
