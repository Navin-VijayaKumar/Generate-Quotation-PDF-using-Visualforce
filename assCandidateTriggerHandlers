    // =======================================================
    // SEND NOTIFICATION
    // =======================================================

    public static void sendnotification(List<Child__c> childlist) {

        Set<Id> childIds = new Set<Id>();

        for (Child__c ch : childlist) {
            childIds.add(ch.Id);
        }

        List<Child__c> childData = [

            SELECT Id,
                   Candidate__c,
                   Candidate_Name__c,
                   Candidate__r.Name,
                   Candidate__r.Whats_App_Number__c,
                   Candidate__r.MobilePhone,
                   Candidate__r.Phone,
                   Candidate__r.Dont_Send_Whatsapp__c

            FROM Child__c
            WHERE Id IN :childIds
        ];

        List<String> mobileList   = new List<String>();
        List<String> recIds       = new List<String>();
        List<String> contactNames = new List<String>();
        List<String> contactIds   = new List<String>();

        for (Child__c ch : childData) {

            String preferredNumber = getPreferredNumber(ch);

            if (String.isNotBlank(preferredNumber)) {

                mobileList.add(preferredNumber);
                recIds.add(ch.Id);
                contactNames.add(ch.Candidate_Name__c);
                contactIds.add(ch.Candidate__c);

            } else {

                System.debug(
                    '⚠️ No valid phone number for Child__c Id: '
                    + ch.Id
                );
            }
        }

        if (!mobileList.isEmpty()) {

            sendTextMessageIntegration(
                mobileList,
                recIds,
                contactNames,
                contactIds
            );

        } else {

            System.debug(
                '⚠️ sendnotification: mobileList empty'
            );
        }
    }

    // =======================================================
    // GET PREFERRED NUMBER
    // =======================================================

    private static String getPreferredNumber(Child__c ch) {

        if (ch.Candidate__r == null) {
            return null;
        }

        // WhatsApp Number
        if (
            !ch.Candidate__r.Dont_Send_Whatsapp__c &&
            String.isNotBlank(ch.Candidate__r.Whats_App_Number__c)
        ) {
            return formatNumber(ch.Candidate__r.Whats_App_Number__c);
        }

        // Mobile
        if (String.isNotBlank(ch.Candidate__r.MobilePhone)) {
            return formatNumber(ch.Candidate__r.MobilePhone);
        }

        // Phone
        if (String.isNotBlank(ch.Candidate__r.Phone)) {
            return formatNumber(ch.Candidate__r.Phone);
        }

        return null;
    }

    // =======================================================
    // FORMAT NUMBER
    // ── same logic as whatsappMessengerForBatchStudent ──────
    // Returns digits only with 91 prefix (no + sign)
    // =======================================================

    private static String formatNumber(String mobilenumber) {

        if (String.isBlank(mobilenumber)) {
            return null;
        }

        mobilenumber = mobilenumber.replaceAll('[^0-9]', '');

        if (mobilenumber.length() == 10) {

            mobilenumber = '91' + mobilenumber;

        } else if (
            mobilenumber.length() == 11 &&
            mobilenumber.startsWith('0')
        ) {

            mobilenumber = '91' + mobilenumber.substring(1);

        } else if (
            mobilenumber.length() == 12 &&
            mobilenumber.startsWith('91')
        ) {

            // already formatted

        } else {

            System.debug(
                '⚠️ Invalid Number Format => '
                + mobilenumber
            );

            return null;
        }

        return mobilenumber;
    }
    
    // =======================================================
    // SEND INTERVIEW SCHEDULED WHATSAPP NOTIFICATION
    // Template  : interview_link_for_salesforce
 
    // Variables : {{contactname}}, {{jobrole}}, {{intdate}}, {{inttime}}
    // =======================================================

  public static void sendInterviewScheduledNotification(List<Child__c> childList) {

        Set<Id> childIds = new Set<Id>();
        for (Child__c ch : childList) {
            childIds.add(ch.Id);
        }

        List<Child__c> childData = [
            SELECT Id,
                   Candidate__c,
                   Candidate_Name__c,
                   Job_Profile__c,
                   Interview_Date_Time__c,
                   Candidate__r.Name,
                   Candidate__r.Whats_App_Number__c,
                   Candidate__r.MobilePhone,
                   Candidate__r.Phone,
                   Candidate__r.Dont_Send_Whatsapp__c
            FROM Child__c
            WHERE Id IN :childIds
        ];
          // Lists used for bulk async WhatsApp sending
        List<String> mobileList    = new List<String>();
        List<String> contactNames  = new List<String>();
        List<String> jobRoles      = new List<String>();
        List<String> intDates      = new List<String>();
        List<String> intTimes      = new List<String>();
        List<String> childIdList   = new List<String>();   
        List<String> contactIdList = new List<String>();   

        for (Child__c ch : childData) {

            String preferredNumber = getPreferredNumber(ch);
                  // Skip record if no valid number found
            if (String.isBlank(preferredNumber)) {
                System.debug(' No valid phone for Child__c Id: ' + ch.Id);
                continue;
            }
              // Format interview date
            String intDate = ch.Interview_Date_Time__c != null
                ? ch.Interview_Date_Time__c.format('dd/MM/yyyy', 'Asia/Kolkata')
                : '';
             // Format interview time
            String intTime = ch.Interview_Date_Time__c != null
                ? ch.Interview_Date_Time__c.format('h.mm a', 'Asia/Kolkata').toLowerCase()
                : '';
               // Prepare data for bulk WhatsApp processing
            mobileList.add(preferredNumber);
            contactNames.add(
                String.isNotBlank(ch.Candidate_Name__c) ? ch.Candidate_Name__c : 'Candidate'
            );
            jobRoles.add(
                String.isNotBlank(ch.Job_Profile__c) ? ch.Job_Profile__c : 'Salesforce'
            );
            intDates.add(intDate);
            intTimes.add(intTime);
            childIdList.add(ch.Id);                        
            contactIdList.add(ch.Candidate__c);           
        }

       /*
     * Call async WhatsApp method
     * to avoid governor limit issues
     */
        if (!mobileList.isEmpty()) {
            sendInterviewWhatsAppAsync(
                mobileList,
                contactNames,
                jobRoles,
                intDates,
                intTimes,
                childIdList,   
                contactIdList   
            );
        } else {
            System.debug(' sendInterviewScheduledNotification: no valid numbers found');
        }
    }

    // =======================================================
    // FUTURE METHOD — Interview Scheduled WhatsApp
    // =======================================================
    
@future(callout=true)
    public static void sendInterviewWhatsAppAsync(
        List<String> mobileList,
        List<String> contactNames,
        List<String> jobRoles,
        List<String> intDates,
        List<String> intTimes,
        List<String> childIds,
        List<String> contactIds
    ) {
        try {
            String apiFetch        = System.Label.AdsEraEndPoint;
            String adseraAPIKey    = System.Label.AdsEraAPIKey;
            String adsEraSecretKey = System.Label.AdsEraSecretKey;
            String whatsappId      = System.Label.AdseraAccountId;
            String templateId      = System.Label.interview_link_for_salesforce;

            List<WhatsappText__c> logsToInsert = new List<WhatsappText__c>();

            for (Integer i = 0; i < mobileList.size(); i++) {
                try {
                    String mobileNumber = mobileList[i];
                    String contactName  = contactNames[i];
                    String jobRole      = jobRoles[i];
                    String intDate      = intDates[i];
                    String intTime      = intTimes[i];
                    String childId      = childIds[i];
                    String contactId    = contactIds[i];

                    // ── Build message preview (what was sent) ──
                    String messagePreview =
                        'Dear ' + contactName + ',\n' +
                        'Your online interview for Salesforce ' + jobRole +
                        ' Role is scheduled on ' + intDate + ' at ' + intTime + '.\n' +
                        'Please join from a laptop using the link.\n' +
                        'The interview will last 60-75 minutes, keep your camera on.\n' +
                        'Best Regards, Shreya Modi, HR Manager';

                    // ── Build request body ──
                    Map<String, Object> body = new Map<String, Object>{
                        'whatsapp'    => whatsappId,
                        'phone'       => mobileNumber,
                        'template'    => templateId,
                        'dynamicData' => new Map<String, Object>{
                            'contactname' => contactName,
                            'jobrole'     => jobRole,
                            'intdate'     => intDate,
                            'inttime'     => intTime
                        }
                    };

                    String requestBody = JSON.serialize(body);

                    HttpRequest req = new HttpRequest();
                    req.setEndpoint(apiFetch + '/api/pub/wa/send/template');
                    req.setMethod('POST');
                    req.setHeader('Content-Type', 'application/json');
                    req.setHeader('x-api-key',    adseraAPIKey);
                    req.setHeader('x-api-secret', adsEraSecretKey);
                    req.setBody(requestBody);
                    req.setTimeout(120000);

                    System.debug('=== Interview WhatsApp ===');
                    System.debug('MOBILE        => ' + mobileNumber);
                    System.debug('CONTACT NAME  => ' + contactName);
                    System.debug('JOB ROLE      => ' + jobRole);
                    System.debug('INT DATE      => ' + intDate);
                    System.debug('INT TIME      => ' + intTime);
                    System.debug('REQUEST BODY  => ' + requestBody);

                    Http http         = new Http();
                    HttpResponse res  = http.send(req);

                    System.debug('STATUS CODE   => ' + res.getStatusCode());
                    System.debug('RESPONSE BODY => ' + res.getBody());
                    System.debug('=========================');

                    // ── Parse message ID from response ──
                    String messageId    = '';
                    String deliveryStatus = res.getStatusCode() == 200 ? 'Sent' : 'Failed';

                    try {
                        Map<String, Object> responseMap =
                            (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
                        List<Object> msgs = (List<Object>) responseMap.get('messages');
                        if (msgs != null && !msgs.isEmpty()) {
                            messageId = String.valueOf(
                                ((Map<String, Object>) msgs[0]).get('id')
                            );
                        }
                    } catch (Exception parseEx) {
                        System.debug('Could not parse messageId: ' + parseEx.getMessage());
                    }

                    // ── Build WhatsappText__c log record ──
                    WhatsappText__c log = new WhatsappText__c(
                        Sent_To__c        = mobileNumber,
                        Text__c           = messagePreview,
                        content__c        = requestBody,
                        Message_Status__c = deliveryStatus,
                        Delivery_Status__c= deliveryStatus,
                        Message_Type__c   = 'Outbound',
                        messageId__c      = messageId,
                        senderName__c     = 'System',
                        Ass_Can__c        = childId
                    );

                    // ── Link Contact if available ──
                    if (String.isNotBlank(contactId)) {
                        log.Contact__c = contactId;
                    }

                    logsToInsert.add(log);

                } catch (Exception ex) {
                    System.debug('INNER EXCEPTION => ' + ex.getMessage());
                    System.debug(' LINE            => ' + ex.getLineNumber());
                }
            }

            // ── Bulk insert all log records ──
            if (!logsToInsert.isEmpty()) {
                insert logsToInsert;
                System.debug('WhatsappText__c records inserted: ' + logsToInsert.size());
            }

        } catch (Exception e) {
            System.debug(' OUTER EXCEPTION => ' + e.getMessage());
            System.debug(' LINE            => ' + e.getLineNumber());
        }
    }
    
    
    
    
    
    
    
    
    
