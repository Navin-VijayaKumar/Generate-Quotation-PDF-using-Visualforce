        Contact con = new Contact(
            LastName              = 'Test Candidate',
            MobilePhone           = '9876543210',
            Whats_App_Number__c   = '9876543210',
            Dont_Send_Whatsapp__c = false
        );
        insert con;

        Job_Opening__c job = new Job_Opening__c(Name = 'Test Job');
        insert job;

        Child__c ch = new Child__c(
            Candidate__c   = con.Id,
            Status__c      = 'HR Interview Scheduled',
            Job_Opening__c = job.Id
        );
        insert ch;
    }

    static Child__c fetchChild() {
        return [
            SELECT Id, Candidate__c, Status__c,
                   Job_Profile__c, Interview_Date_Time__c,
                   Subhadeep_Interview_Date__c, Jay_Interview_Date__c,
                   Sabya_Sir_Round_Interview_Date_Time__c
            FROM   Child__c LIMIT 1
        ];
    }

    static Contact fetchContact() {
        return [SELECT Id FROM Contact LIMIT 1];
    }

